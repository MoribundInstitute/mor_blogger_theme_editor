# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/
/target

# Local editor preferences (runtime-generated)
editor_prefs.json
mor_blogger_dioxus_ui/editor_prefs.json

# Dev scratch: grep output, CSS dumps, accidental files
grep_*.txt
css_native_matches.txt
combined.css
sys
ROUTE:*

# Build outputs (test fixtures under build/fixtures/ stay tracked)
build/proof/
build/*.xml
build/restored_vfs/

# graphify knowledge graph: ignore caches & machine-local state, keep shareable outputs
# (graph.json, graph.html, GRAPH_REPORT.md stay tracked)
graphify-out/cache/
graphify-out/.graphify_*
graphify-out/cost.json
graphify-out/manifest.json
graphify-out/*.bak
mor_blogger_dioxus_ui/assets/js/cm6/node_modules/

# editor / agent tooling configs (machine-local)
.agents/
.cursor/

# Dioxus web build output (generated by dx build)
dist/
