<b:widget id='Blog1' locked='true' title='{{BLOG_WIDGET_TITLE}}' type='Blog' version='2' visible='true'>
  <b:widget-settings>
    <b:widget-setting name='showDateHeader'>true</b:widget-setting>
    <b:widget-setting name='showShareButtons'>true</b:widget-setting>
    <b:widget-setting name='showCommentLink'>true</b:widget-setting>
    <b:widget-setting name='showAuthor'>true</b:widget-setting>
    <b:widget-setting name='showLabels'>true</b:widget-setting>
    <b:widget-setting name='showTimestamp'>true</b:widget-setting>
    <b:widget-setting name='showLocation'>false</b:widget-setting>
    <b:widget-setting name='style.layout'>1x1</b:widget-setting>
    <b:widget-setting name='style.unittype'>TextAndImage</b:widget-setting>
  </b:widget-settings>

  <b:includable id='main' var='top'>
    <b:if cond='data:view.isSingleItem'>
      <b:loop values='data:posts' var='post'>
        <b:include data='post' name='post'/>
      </b:loop>
    <b:else/>
      <div class='mor-magazine-feed'>
        <b:loop index='i' values='data:posts' var='post'>
          <b:if cond='data:i == 0'>
            <b:include data='post' name='heroPost'/>
          <b:else/>
            <b:include data='post' name='gridPost'/>
          </b:if>
        </b:loop>
      </div>
      <b:include name='postPagination'/>
    </b:if>
  </b:includable>

  <b:includable id='heroPost' var='post'>
    <article class='mor-post hero-post'>
      <b:if cond='data:post.featuredImage'>
        <img class='post-thumbnail' expr:alt='data:post.title' expr:src='data:post.featuredImage'/>
      </b:if>
      <h2 class='post-title'>
        <a expr:href='data:post.url'><data:post.title/></a>
      </h2>
      <div class='post-meta'>
        <span class='sys-date'><data:post.dateHeader/></span>
        <b:if cond='data:post.author'>
          <span class='post-author'> | <data:post.author.name/></span>
        </b:if>
      </div>
      <div class='post-body'>
        <data:post.snippet/>
      </div>
    </article>
  </b:includable>

  <b:includable id='gridPost' var='post'>
    <article class='mor-post grid-post'>
      <b:if cond='data:post.featuredImage'>
        <img class='post-thumbnail' expr:alt='data:post.title' expr:src='data:post.featuredImage'/>
      </b:if>
      <h2 class='post-title'>
        <a expr:href='data:post.url'><data:post.title/></a>
      </h2>
      <div class='post-meta'>
        <span class='sys-date'><data:post.dateHeader/></span>
      </div>
      <div class='post-body'>
        <data:post.snippet/>
      </div>
    </article>
  </b:includable>

  <b:includable id='post' var='post'>
    <article class='mor-post hero-post'>
      <b:include data='post' name='postTitle'/>
      <div class='post-meta'>
        <b:include data='post' name='postTimestamp'/>
        <b:include data='post' name='postLabels'/>
      </div>
      <b:include data='post' name='postBody'/>
      <div class='post-footer'>
        <b:include data='post' name='postFooterAuthorProfile'/>
        <b:include cond='data:post.shareUrl' name='postShareButtons'/>
      </div>
      <b:include data='post' name='postCommentsAndAd'/>
    </article>
  </b:includable>

  <b:includable id='postTitle' var='post'>
    <b:if cond='data:post.title'>
      <h2 class='post-title'>
        <a expr:href='data:post.url'><data:post.title/></a>
      </h2>
    </b:if>
  </b:includable>

  <b:includable id='postBody' var='post'>
    <div class='post-body entry-content'>
      <data:post.body/>
    </div>
  </b:includable>

  <b:includable id='postCommentsAndAd' var='post'>
    <b:include data='post' name='comments'/>
  </b:includable>

  <b:includable id='postPagination'>
    <div class='mor-pager'>
      <b:if cond='data:newerPageUrl'>
        <a class='pager-btn' expr:href='data:newerPageUrl'>{{PAGER_NEWER_LABEL}}</a>
      </b:if>
      <b:if cond='data:olderPageUrl'>
        <a class='pager-btn' expr:href='data:olderPageUrl'>{{PAGER_OLDER_LABEL}}</a>
      </b:if>
    </div>
  </b:includable>

  <b:includable id='comments' var='post'>
    <b:if cond='data:post.allowComments'>
      <section class='comments' expr:id='data:post.id + &quot;_comments&quot;'>
        <b:include data='post' name='commentPicker'/>
      </section>
    </b:if>
  </b:includable>

  <b:includable id='commentPicker' var='post'>
    <b:include data='post' name='threadedComments'/>
  </b:includable>

  <b:includable id='threadedComments' var='post'>
    <div class='comments-placeholder'>
      <b:if cond='data:post.numComments'>
        <a expr:href='data:post.url + &quot;#comments&quot;'>
          <data:post.numComments/> comment(s)
        </a>
      </b:if>
    </div>
  </b:includable>

  <b:includable id='postFooterAuthorProfile' var='post'>
    <b:if cond='data:view.isPost and data:post.author'>
      <div class='author-profile'>
        <span class='author-name'><data:post.author.name/></span>
      </div>
    </b:if>
  </b:includable>

  <b:includable id='postShareButtons' var='post'>
    <div class='byline post-share-buttons'>
      <b:if cond='data:post.shareUrl'>
        <a class='sharing-link' expr:href='data:post.shareUrl'>Share</a>
      </b:if>
    </div>
  </b:includable>

  <b:includable id='postLabels' var='post'>
    <b:if cond='data:post.labels'>
      <span class='sys-tags'>
        {{POST_TAGS_PREFIX}}
        <b:loop values='data:post.labels' var='label'>
          <a expr:href='data:label.url' rel='tag'><data:label.name/></a><b:if cond='not data:label.isLast'>, </b:if>
        </b:loop>
      </span>
    </b:if>
  </b:includable>

  <b:includable id='postTimestamp' var='post'>
    <b:if cond='data:post.timestamp'>
      <span class='timestamp'><data:post.timestamp/></span>
    </b:if>
  </b:includable>

  <b:includable id='postFooter' var='post'>
    <div class='post-footer'>
      <b:include data='post' name='postTimestamp'/>
      <b:include data='post' name='postLabels'/>
    </div>
  </b:includable>
</b:widget>