<header class="mor-header-baseline" id="mor-header">
    
    <button class="panel-toggle left-panel-toggle" data-target="panel-left" aria-label="Open Browse Panel">
        {{LEFT_PANEL_OPEN_LABEL}}
    </button>

    <div class="mor-header-brand">
        {{HEADER_LOGO_IMG}}
    </div>

    <nav class="mor-catalog-mega-dropdown">
        <button class="catalog-toggle" aria-haspopup="true" aria-expanded="false">
            {{CATALOG_OPEN_LABEL}}
        </button>
        
        <div class="dropdown-content">
            {{SUBJECT_LIST}}
            {{LEXICON_LIST}}
            {{MEDIA_LIST}}
            {{WIKI_LIST}}
            {{PROJECTS_LIST}}
            {{PROGRESS_LIST}}
        </div>
    </nav>

    <button class="panel-toggle right-panel-toggle" data-target="panel-right" aria-label="Open Contents Panel">
        {{RIGHT_PANEL_OPEN_LABEL}}
    </button>

</header>