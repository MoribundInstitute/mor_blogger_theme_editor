        format!("<img alt=\"{} logo\" class='institute-logo' src=\"{}\"/>", escape_attr(&config.site.site_title), escape_attr(&config.site.header_logo_url))
    };

    let menu_1 = menu_link_or_empty(config, 0);
    let menu_2 = menu_link_or_empty(config, 1);
    let menu_3 = menu_link_or_empty(config, 2);
    let menu_4 = menu_link_or_empty(config, 3);

    xml = xml.replace("{{MAIN_NAV_LINKS}}", &render_main_nav_links(config));
    xml = xml.replace("{{HEADER_LOGO_IMG}}", &header_logo_img);

    // The sidebar-toggle icons are drawn by the `.header-panel-toggle-*::before`
    // CSS mask (fed by the `--icon-sidebar-*` custom properties that css_builder
    // emits from this same config), so these sockets only need:
    //   * `{{*_PANEL_MASK}}`       -> a valid CSS `mask-image` value, and
    //   * `{{*_PANEL_OPEN_LABEL}}` -> a plain text label.
