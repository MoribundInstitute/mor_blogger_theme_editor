/// Normalize any icon source — an existing CSS `url(...)`, raw `<svg>` markup, or
/// bare SVG path data — into a CSS mask value of the form
/// `url("data:image/svg+xml,<percent-encoded svg>")`.
///
/// The result is passed through `escape_attr` before it is written into the
/// `mask-image` declaration, so the quotes inside the data URI survive strict XML
/// parsing as `&quot;` / `&#39;` and decode back to valid CSS in the browser.
fn to_mask_url(value: &str) -> String {
    let v = value.trim();
    if v.is_empty() {
        return String::from("none");
    }
    // Already a CSS url(...) mask — use as-is (this is how presets store icons).
    if v.starts_with("url(") {
        return v.to_string();
    }
    let svg = if v.starts_with("<svg") {
        v.to_string()
    } else {
        // Treat the value as raw path data and wrap it in a minimal filled SVG.
        format!(
            "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='{}'/></svg>",
            v
        )
    };
    format!("url(\"data:image/svg+xml,{}\")", svg_percent_encode(&svg))
}

/// Percent-encode only the characters that are unsafe inside a CSS
/// `url("data:image/svg+xml,...")` payload. Spaces and single quotes are valid
/// inside a double-quoted `url()`, so they are left as-is.
fn svg_percent_encode(input: &str) -> String {
    let mut out = String::with_capacity(input.len() + input.len() / 4);
    for byte in input.bytes() {
        match byte {
            b'<' => out.push_str("%3C"),
            b'>' => out.push_str("%3E"),
            b'#' => out.push_str("%23"),
            b'%' => out.push_str("%25"),
            b'"' => out.push_str("%22"),
            _ => out.push(byte as char),
        }
    }
    out
}

fn render_main_nav_links(config: &ThemeConfig) -> String {
    config
        .menu_links
        .iter()
        .filter_map(render_menu_link)
        .collect::<Vec<_>>()
        .join("\n      ")
}

fn render_menu_link(link: &MenuLink) -> Option<String> {
    let label = link.label.trim();
    let url = link.url.trim();

    if label.is_empty() || url.is_empty() {
        return None;
    }

    Some(format!(
        "<a href=\"{url}\">{label}</a>",
        url = escape_attr(url),
        label = escape_html(label),
    ))
}