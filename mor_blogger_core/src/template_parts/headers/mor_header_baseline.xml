    // We deliberately do NOT inject the icon as `<svg><path d="..."/></svg>`.
    // The stored icon is a `url("data:image/svg+xml,...")` mask string, and
    // dropping a `url("..."` into a path's `d` attribute closes that attribute on
    // its first inner double-quote — the very next character is the `d` of
    // `data:`, which is what tripped Blogger's strict XML parser
    // ("expected a whitespace not 'd'") and cascaded into the dead preview iframe.
    let left_mask = to_mask_url(first_non_empty(&config.icons.sidebar_left, DEFAULT_LEFT_ICON_PATH));
    let right_mask = to_mask_url(first_non_empty(&config.icons.sidebar_right, DEFAULT_RIGHT_ICON_PATH));

    xml = xml.replace("{{LEFT_PANEL_MASK}}", &escape_attr(&left_mask));
    xml = xml.replace("{{RIGHT_PANEL_MASK}}", &escape_attr(&right_mask));
    xml = xml.replace("{{LEFT_PANEL_OPEN_LABEL}}", &escape_html("Browse"));
