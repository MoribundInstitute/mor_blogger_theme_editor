<aside class='runelite-panel panel-left' id='panel-left'>
  <div class='panel-header'>
    <span>{{LEFT_PANEL_TITLE}}</span>
    <button aria-label='Close Browse panel' class='panel-toggle' data-target='panel-left'>
      <svg fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" height="1.2em" width="1.2em" xmlns="http://www.w3.org/2000/svg"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <div class='panel-content' id='toc-container'>
    <b:section class='sidebar-section' id='sidebar-left' showaddelement='yes'>
      {{SOCKET_SIDEBAR_LEFT}}
    </b:section>
  </div>
</aside>
