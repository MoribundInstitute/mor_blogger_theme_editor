{
  "name": "morblogger-cm6",
  "private": true,
  "version": "1.0.0",
  "description": "CodeMirror 6 bundle for the MorBlogger code editors. Built output is vendored at ../cm6.bundle.js; rebuild with `npm i && npm run build`.",
  "type": "module",
  "scripts": {
    "build": "esbuild entry.mjs --bundle --format=iife --minify --outfile=../cm6.bundle.js"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-css": "^6.3.0",
    "@codemirror/lang-html": "^6.4.9",
    "@codemirror/lang-javascript": "^6.2.2",
    "@codemirror/lang-json": "^6.0.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/legacy-modes": "^6.4.0",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.28.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "codemirror": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "^0.21.5"
  }
}
